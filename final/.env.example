# Copie este arquivo para .env e preencha.
# Todo programa que coleta um site deve se identificar e dizer como falar com o dono.
# Troque pelo seu contato (um e-mail ou o endereço do seu repositório).
G1_USER_AGENT="meu-projeto-de-estudo/0.1 (seu-contato-aqui)"
# Segundos de espera entre uma requisição e a próxima (mínimo 1 para não passar de 1 por segundo).
G1_PAUSA=1
