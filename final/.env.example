# Copie este arquivo para .env e troque o contato pelo seu.
# Todo programa que pede páginas a um site deve dizer quem é e como falar com o dono.
# O contato precisa ser um e-mail ou um endereço de verdade, como o do seu repositório.
# Enquanto a linha tiver seu-usuario, o programa não roda.
G1_USER_AGENT="projeto-de-estudo/0.1 (https://github.com/seu-usuario/projeto-g1)"

# O Postgres do projeto roda no Docker (compose.yaml), na porta 5435. A senha e o endereço são de treino:
# o banco só existe na sua máquina. Mesmo assim, ficam no .env, fora do Git.
POSTGRES_PASSWORD=treino
DATABASE_URL=postgresql://postgres:treino@localhost:5435/postgres
